---
/*
  Nouveautés — journal des évolutions visibles du site (signature commune des apps).

  Source : docs/nouveautes/*.md, compilé par `cadence news build` (`npm run news`)
  dans public/nouveautes-data/ (nouveautes.json + captures), versionné : Cloudflare
  Pages construit sans cadence. La page est rendue AU BUILD depuis ce JSON, déjà
  trié du plus récent au plus ancien (date, puis heure de création).
*/
import { readFileSync } from 'node:fs';
import { join } from 'node:path';
import CodexLayout from '../layouts/CodexLayout.astro';
import { formatDay } from '../lib/format-date.mjs';
import news from '../../public/nouveautes-data/nouveautes.json';

interface NewsEntry {
  slug: string;
  title: string;
  date: string;
  lots: string[];
  captures: string[];
  html: string;
}

const BASE = '/nouveautes-data';
const entries = (news as { entries: NewsEntry[] }).entries;

const formatDate = formatDay;

// Dimensions lues dans l'en-tête PNG (IHDR) : réservent la place des captures,
// pas de saut de mise en page au chargement.
const pngSize = (rel: string) => {
  const buf = readFileSync(join(process.cwd(), 'public', 'nouveautes-data', rel));
  return { width: buf.readUInt32BE(16), height: buf.readUInt32BE(20) };
};
---
<CodexLayout
  title="Nouveautés — Evatosorus"
  description="Ce qui a changé sur Evatosorus, la nouveauté la plus récente en premier."
  active="nouveautes"
>
  <div class="news">
    <header>
      <p class="codex-eyebrow">nouveautés</p>
      <h1>Ce qui a changé</h1>
      <p class="lede">
        Le journal des évolutions du site, la plus récente en premier.
      </p>
      {/* L27 : rempli au chargement selon la dernière visite (localStorage). */}
      <p class="news-since" role="status"></p>
      <p id="news-copy-status" class="news-sr" role="status"></p>
    </header>

    {entries.length === 0 ? (
      <p class="news-empty">Aucune nouveauté publiée pour l'instant.</p>
    ) : (
      <ol class="news-list">
        {entries.map((e) => (
          <li>
            <article class="news-entry" id={e.slug} tabindex="-1" aria-labelledby={`${e.slug}-titre`}>
              {/* L27 (revue UX) : lien permanent par un bouton visible sans survol, après la
                  date et la marque « Nouveau » ; le titre reste du texte (un toucher sur le
                  titre écrasait le presse-papiers et faisait défiler la page). */}
              <p class="news-date">
                <time datetime={e.date}>{formatDate(e.date)}</time><span class="news-new-slot"></span>
                <button type="button" class="news-copy" data-slug={e.slug} data-state="idle">
                  <svg class="news-copy-icon" viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M10 13a5 5 0 0 0 7.54.54l3-3a5 5 0 0 0-7.07-7.07l-1.72 1.71" />
                    <path d="M14 11a5 5 0 0 0-7.54-.54l-3 3a5 5 0 0 0 7.07 7.07l1.71-1.71" />
                  </svg>
                  {/* Les trois libellés partagent la même case : la largeur du plus long est
                      réservée, le retour ne décale rien. */}
                  <span class="news-copy-labels" aria-hidden="true">
                    <span class="news-copy-label" data-for="idle">Copier le lien</span>
                    <span class="news-copy-label is-hidden" data-for="ok">Lien copié</span>
                    <span class="news-copy-label is-hidden" data-for="ko">Lien dans l’adresse</span>
                  </span>
                  <span class="news-sr">Copier le lien : {e.title}</span>
                </button>
              </p>
              <h2 id={`${e.slug}-titre`}>{e.title}</h2>
              {/* HTML produit par cadence depuis le Markdown du dépôt (texte échappé à la génération). */}
              <div class="news-body" set:html={e.html} />
              {e.captures.length > 0 && (
                <div class="news-captures" data-lightbox>
                  {e.captures.map((c, i) => {
                    const { width, height } = pngSize(c);
                    const alt = e.captures.length > 1
                      ? `Capture d'écran ${i + 1} sur ${e.captures.length} : ${e.title}`
                      : `Capture d'écran : ${e.title}`;
                    return (
                      <a
                        href={`${BASE}/${c}`}
                        class="news-capture"
                        style={`width: min(100%, ${width}px, calc(32rem * ${width} / ${height}))`}
                      >
                        <img
                          src={`${BASE}/${c}`}
                          alt={alt}
                          width={width}
                          height={height}
                          style={`aspect-ratio: ${width} / ${height}`}
                          loading="lazy"
                          decoding="async"
                        />
                      </a>
                    );
                  })}
                </div>
              )}
            </article>
          </li>
        ))}
      </ol>
    )}
  </div>

  <style>
    .news {
      max-width: 70ch;
    }
    .codex-eyebrow {
      font-family: var(--font-display);
      font-size: 0.72rem;
      letter-spacing: 0.32em;
      color: var(--color-evato-amber);
      text-transform: uppercase;
      margin: 0 0 0.4rem;
      /* Posé sur l'image de fond, en petit corps : ombre de la marque doublée d'un
         halo serré, ≥ 4,5:1 au pire pixel (L13). */
      text-shadow: 0 0 2px rgba(0, 0, 0, 0.9), 0 1px 3px rgba(0, 0, 0, 0.85);
    }
    .news h1 {
      font-size: clamp(2rem, 6vw, 2.6rem);
      margin: 0 0 0.8rem;
      overflow-wrap: anywhere;
    }
    .lede {
      font-size: 1.2rem;
      line-height: 1.7;
      color: var(--color-evato-bone);
      text-shadow: 0 1px 3px rgba(0, 0, 0, 0.85);
      margin: 0 0 2.5rem;
    }
    .news-list {
      list-style: none;
      margin: 0;
      padding: 0;
      display: flex;
      flex-direction: column;
      gap: 1.75rem;
    }
    /* Carte quasi opaque : le texte garde son contraste quelle que soit la zone
       de l'image de fond qui passe derrière. */
    .news-entry {
      padding: 1.5rem clamp(1rem, 4vw, 1.8rem) 1.75rem;
      background: rgba(20, 14, 8, 0.92);
      border: 1px solid rgba(212, 165, 94, 0.25);
      border-left: 3px solid var(--color-evato-amber);
      border-radius: 6px;
      box-shadow: 0 12px 24px -12px rgba(0, 0, 0, 0.6);
    }
    /* L27 — entrée visée par un lien permanent : posée sous le haut de l'écran
       (au téléphone, sous le bouton fixe du menu), bord ambre vif ; le focus
       programmatique n'ajoute pas de second contour. */
    .news-entry {
      scroll-margin-top: 1.5rem;
    }
    /* Au téléphone, c'est le scroll-padding-top de la page (CodexLayout, sous le bouton
       fixe du menu) qui place l'entrée : pas de marge en plus, sinon les deux s'ajoutent. */
    @media (max-width: 1023px) {
      .news-entry { scroll-margin-top: 0; }
    }
    .news-entry:focus {
      outline: none;
    }
    .news-entry.is-target {
      border-color: var(--color-evato-amber-bright);
      box-shadow: 0 0 0 1px var(--color-evato-amber-bright), 0 12px 24px -12px rgba(0, 0, 0, 0.6);
    }
    /* L27 (revue UX) — bouton « Copier le lien » : visible sans survol, cible ≥ 24 px
       au bureau et ≥ 44 px au toucher ; le retour remplace le libellé dans une case de
       largeur fixe (celle du plus long). */
    .news-copy {
      display: inline-flex;
      align-items: center;
      gap: 0.4rem;
      min-height: 1.75rem;
      min-width: 1.5rem;
      padding: 0 0.55rem;
      border: 1px solid rgba(212, 165, 94, 0.45);
      border-radius: 4px;
      background: transparent;
      color: var(--color-evato-amber-bright);
      font-family: var(--font-body, inherit);
      font-size: 0.8rem;
      letter-spacing: 0.02em;
      text-transform: none;
      cursor: pointer;
    }
    .news-copy:hover {
      border-color: var(--color-evato-amber-bright);
      background: rgba(212, 165, 94, 0.08);
    }
    .news-copy:focus-visible {
      outline: 2px solid var(--color-evato-amber-bright);
      outline-offset: 2px;
    }
    @media (pointer: coarse) {
      .news-copy { min-height: 2.75rem; min-width: 2.75rem; }
    }
    .news-copy-icon {
      flex: none;
    }
    .news-copy-labels {
      display: inline-grid;
    }
    .news-copy-label {
      grid-area: 1 / 1;
      white-space: nowrap;
    }
    .news-copy-label.is-hidden {
      visibility: hidden;
    }
    .news-sr {
      position: absolute;
      width: 1px;
      height: 1px;
      padding: 0;
      margin: -1px;
      overflow: hidden;
      clip: rect(0, 0, 0, 0);
      white-space: nowrap;
      border: 0;
    }
    /* L27 — « N nouveautés depuis votre dernière visite » : bandeau sur le fond de carte
       (lisible quelle que soit l'image derrière), masqué quand il est vide. */
    .news-since {
      margin: -1.25rem 0 2rem;
      padding: 0.6rem 1rem;
      background: rgba(20, 14, 8, 0.92);
      border-left: 3px solid var(--color-evato-amber-bright);
      border-radius: 4px;
      color: var(--color-evato-bone);
      font-size: 1rem;
    }
    .news-since:empty {
      display: none;
    }
    /* Marque « Nouveau » : un mot écrit, pas seulement une couleur. */
    .news-list :global(.news-new) {
      display: inline-block;
      margin-left: 0.75rem;
      padding: 0.15rem 0.55rem;
      border-radius: 999px;
      background: var(--color-evato-amber-bright);
      color: var(--color-evato-bg);
      font-weight: 700;
      letter-spacing: 0.12em;
    }
    /* Séparateur « Déjà vu lors de votre visite du … » avant la première entrée déjà vue. */
    .news-list :global(.news-seen-sep) {
      display: flex;
      align-items: center;
      gap: 0.8rem;
    }
    .news-list :global(.news-seen-sep)::before,
    .news-list :global(.news-seen-sep)::after {
      content: "";
      flex: 1;
      border-top: 1px solid rgba(212, 165, 94, 0.45);
    }
    .news-list :global(.news-seen-sep span) {
      padding: 0.25rem 0.75rem;
      border-radius: 999px;
      background: rgba(20, 14, 8, 0.92);
      color: var(--color-evato-bone-muted);
      font-size: 0.85rem;
      text-align: center;
    }
    .news-date {
      display: flex;
      flex-wrap: wrap;
      align-items: center;
      gap: 0.5rem 0.75rem;
      font-family: var(--font-display);
      font-size: 0.78rem;
      letter-spacing: 0.2em;
      text-transform: uppercase;
      color: var(--color-evato-amber);
      margin: 0 0 0.5rem;
    }
    .news-entry h2 {
      font-size: clamp(1.2rem, 4.2vw, 1.45rem);
      letter-spacing: 0.04em;
      line-height: 1.35;
      color: var(--color-evato-amber-bright);
      margin: 0 0 1rem;
      overflow-wrap: anywhere;
    }
    .news-body :global(p),
    .news-body :global(li) {
      font-size: 1.05rem;
      line-height: 1.75;
      color: var(--color-evato-bone);
    }
    .news-body :global(p) { margin: 0 0 0.8rem; }
    .news-body :global(ul) {
      margin: 0 0 0.8rem;
      padding-left: 1.3rem;
      list-style: disc;
    }
    .news-body :global(li) { margin-bottom: 0.45rem; }
    .news-body :global(li::marker) { color: var(--color-evato-amber); }
    .news-body :global(strong) { color: var(--color-evato-bone); font-weight: 600; }
    .news-body :global(code) {
      font-size: 0.9em;
      padding: 0 0.3em;
      border-radius: 3px;
      background: rgba(212, 165, 94, 0.12);
    }
    .news-body :global(a) {
      color: var(--color-evato-amber-bright);
      text-decoration: underline;
      text-underline-offset: 3px;
    }
    .news-captures {
      display: flex;
      flex-wrap: wrap;
      gap: 1rem;
      margin-top: 1.25rem;
    }
    .news-capture {
      display: block;
      flex: 0 1 auto;
      min-width: 0;
      max-width: 100%;
      border-radius: 4px;
      line-height: 0;
    }
    /* Taille réservée AVANT chargement (pas de saut de mise en page) : le lien prend
       min(largeur dispo, largeur naturelle, largeur qui donne 32rem de haut), l'image
       le remplit à ses proportions (aspect-ratio en ligne). Une capture de téléphone
       ne s'étire pas, une capture de bureau ne déborde jamais. */
    .news-capture img {
      display: block;
      width: 100%;
      height: auto;
      border: 1px solid rgba(212, 165, 94, 0.3);
      border-radius: 4px;
      cursor: zoom-in;
    }
    .news-empty {
      color: var(--color-evato-bone-muted);
      font-style: italic;
    }
  </style>

  <script>
    import { entryForFragment, permalink } from '../lib/news-anchor';
    import {
      NEWS_SEEN_EVENT, browserStorage, isUnseen, markAllSeen, readSeen, seenSeparatorIndex, seenSeparatorLabel,
    } from '../lib/news-badge';

    // L27 — dernière visite (repris d'AetherWX news-badge) : « N nouveautés depuis votre
    // dernière visite », marque « Nouveau » sur ces entrées, séparateur « Déjà vu lors de
    // votre visite du … » avant la première déjà vue ; puis tout est marqué vu et la
    // pastille du menu s'éteint. Premier visiteur : rien n'est marqué nouveau.
    function markVisit() {
      const list = document.querySelector('.news-list');
      if (!list) return;
      const articles = [...list.querySelectorAll<HTMLElement>('article.news-entry')];
      const entries = articles.map((a) => ({ slug: a.id, date: a.querySelector('time')!.dateTime }));
      const storage = browserStorage();
      const seen = readSeen(storage);
      const fresh = entries.map((e) => isUnseen(e, seen));
      const count = fresh.filter(Boolean).length;

      articles.forEach((a, i) => {
        const slot = a.querySelector('.news-new-slot');
        if (!slot) return;
        slot.replaceChildren();
        if (fresh[i]) {
          const mark = document.createElement('span');
          mark.className = 'news-new';
          mark.textContent = 'Nouveau';
          slot.append(mark);
        }
      });
      const since = document.querySelector('.news-since');
      if (since) {
        since.textContent = !count ? '' : count === 1
          ? '1 nouveauté depuis votre dernière visite'
          : `${count} nouveautés depuis votre dernière visite`;
      }
      list.querySelectorAll('.news-seen-sep').forEach((n) => n.remove());
      // Avant la première entrée vue, seulement si toutes les nouvelles sont au-dessus.
      const at = seen ? seenSeparatorIndex(fresh) : -1;
      if (at > 0) {
        const sep = document.createElement('li');
        sep.className = 'news-seen-sep';
        // Repère visuel ; la ligne « N nouveautés depuis… » le dit aux lecteurs d'écran.
        sep.setAttribute('aria-hidden', 'true');
        const text = document.createElement('span');
        text.textContent = seenSeparatorLabel(seen!.at);
        sep.append(text);
        articles[at].closest('li')!.before(sep);
      }
      markAllSeen(storage, entries);
      window.dispatchEvent(new Event(NEWS_SEEN_EVENT));
    }
    markVisit();

    // L27 (revue UX) — « Copier le lien » : copie seulement, sans défilement ni
    // changement d'adresse ; retour dans le libellé du bouton (largeur réservée) et annonce
    // pour lecteur d'écran. Copie refusée : le lien est posé dans l'adresse SANS défiler
    // (replaceState, pas de hashchange).
    const copyStatus = document.getElementById('news-copy-status');
    const timers = new WeakMap<HTMLElement, ReturnType<typeof setTimeout>>();
    function setState(btn: HTMLElement, state: 'idle' | 'ok' | 'ko') {
      btn.dataset.state = state;
      btn.querySelectorAll<HTMLElement>('.news-copy-label').forEach((l) => {
        l.classList.toggle('is-hidden', l.dataset.for !== state);
      });
    }
    document.addEventListener('click', async (e) => {
      const btn = (e.target as Element | null)?.closest?.<HTMLElement>('button.news-copy');
      if (!btn) return;
      const slug = btn.dataset.slug!;
      const url = permalink(location.origin, slug);
      let ok = true;
      try {
        await navigator.clipboard.writeText(url);
      } catch {
        ok = false;
        history.replaceState(history.state, '', `#${encodeURIComponent(slug)}`);
      }
      setState(btn, ok ? 'ok' : 'ko');
      if (copyStatus) {
        copyStatus.textContent = ok
          ? 'Lien copié dans le presse-papiers'
          : "Copie impossible : le lien est dans la barre d'adresse";
      }
      clearTimeout(timers.get(btn));
      timers.set(btn, setTimeout(() => {
        setState(btn, 'idle');
        if (copyStatus) copyStatus.textContent = '';
      }, 4000));
    });

    // À l'arrivée sur une ancre (ou à son changement), l'entrée est signalée et reçoit le
    // focus ; le défilement natif tient compte de scroll-margin-top.
    function revealTarget() {
      const articles = [...document.querySelectorAll<HTMLElement>('article.news-entry')];
      const slug = entryForFragment(location.hash, articles.map((a) => ({ slug: a.id })));
      for (const a of articles) a.classList.toggle('is-target', a.id === slug);
      if (slug) document.getElementById(slug)!.focus({ preventScroll: true });
    }
    revealTarget();
    window.addEventListener('hashchange', revealTarget);
  </script>
</CodexLayout>
