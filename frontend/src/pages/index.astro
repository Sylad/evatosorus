---
import BaseLayout from '../layouts/BaseLayout.astro';
import EvatoLogo from '../components/EvatoLogo.astro';
import EvatoSkull from '../components/EvatoSkull.astro';
import { HeroVideoCycle } from '../components/cinema/HeroVideoCycle';
import { DustField } from '../components/cinema/DustField';
import { SPECIES } from '../data/species';

// Espace fine insécable (U+202F) de fr-FR → insécable classique : Cinzel et
// Crimson Text n'ont pas le glyphe U+202F, « 1 511 » s'affichait « 1511 ».
const totalSpecies = SPECIES.length.toLocaleString('fr-FR').replace(/\u202f/g, '\u00a0');
---
<BaseLayout
  title="Evatosorus — Codex Mésozoïque"
  description="Un codex visuel des dinosaures — Trias, Jurassique, Crétacé. 1500+ espèces, paleo-art domaine public."
>
  <!--
    Landing — full-viewport background video. Trois couches :
      1. HeroVideoCycle : 3 MP4 openart.ai (T-Rex jungle/volcan/orage)
         empilés en background fixed, cross-fade toutes les 25s.
      2. DustField : poussière ambre/cendre par-dessus la vidéo.
      3. Voile sombre gradient (main::before) pour la lisibilité du logo.
    Le contenu (logo + tagline + CTAs) flotte au centre sur la vidéo.
  -->
  <HeroVideoCycle client:only="react" />
  <DustField client:only="react" />

  <main class="landing">
    <div class="landing-skull"><EvatoSkull size={300} /></div>
    <h1 class="landing-title"><EvatoLogo size={500} /></h1>

    <p class="landing-tagline font-body" data-amber-split>
      Un musée vivant du Mésozoïque pour Eva : scènes de vie, fossiles, cartes
      et créatures qui ont vraiment habité la Terre.
    </p>

    <!--
      Hiérarchie (maquette 390 px validée par Sylvain le 2026-10-01) : une seule
      action pleine (Explorer le codex), une en contour (Espèces vitrines), puis
      les autres sections en liens secondaires, dans l'ordre de la nav interne
      de CodexLayout. Les deux actions principales tiennent au-dessus de la ligne
      de flottaison, au téléphone compris.
    -->
    <nav class="landing-nav" aria-label="Sections du codex">
      <div class="landing-primary">
        <a href="/codex/" class="cta cta-primary">Explorer le codex</a>
        <a href="/vitrines/" class="cta cta-outline">Espèces vitrines</a>
      </div>
      <ul class="landing-secondary">
        <li><a href="/comprendre/" class="cta-link">Comprendre</a></li>
        <li><a href="/periodes/" class="cta-link">Voyage temporel</a></li>
        <li><a href="/carte/" class="cta-link">Carte paléo-monde</a></li>
        <li><a href="/films/" class="cta-link">Films</a></li>
        <li><a href="/videos/" class="cta-link">Vidéos</a></li>
        <li><a href="/about/" class="cta-link">À propos</a></li>
      </ul>
    </nav>

    <p class="landing-sub font-body" data-amber-split>
      « Avant nous, il y a eu eux. »<br/>
      Trias, Jurassique, Crétacé. {totalSpecies} espèces, des paysages perdus
      et quelques géants remis en mouvement.
    </p>

    <div class="landing-stats" aria-label="Aperçu du contenu Evatosorus">
      <span><strong>{totalSpecies}</strong> espèces</span>
      <span><strong>20</strong> scènes animées</span>
      <span><strong>3</strong> ères à explorer</span>
    </div>
  </main>
</BaseLayout>

<script is:inline>
  // Wraps each word in [data-amber-split] paragraphs in <span class="amber-word">
  // so the cursor can light up individual words in fossil-amber.
  (() => {
    if (typeof window === 'undefined') return;
    const split = () => {
      const targets = document.querySelectorAll('[data-amber-split]');
      targets.forEach((p) => {
        if (p.dataset.amberSplitDone === '1') return;
        Array.from(p.childNodes).forEach((node) => {
          if (node.nodeType !== Node.TEXT_NODE) return;
          const text = node.textContent ?? '';
          if (!text.trim()) return;
          const frag = document.createDocumentFragment();
          text.split(/(\s+)/).forEach((tok) => {
            if (/^\s+$/.test(tok) || tok === '') {
              frag.appendChild(document.createTextNode(tok));
            } else {
              const span = document.createElement('span');
              span.className = 'amber-word';
              span.textContent = tok;
              frag.appendChild(span);
            }
          });
          p.replaceChild(frag, node);
        });
        p.dataset.amberSplitDone = '1';
      });
    };
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', split);
    } else {
      split();
    }
    document.addEventListener('astro:page-load', split);
  })();
</script>

<style>
  /*
    PAS de voile main::before sur la landing : le radial-gradient dark
    précédent (rgba 0.7 au centre) tuait toute la saturation du logo et
    du texte. Sylvain l'a identifié 2026-05-07. Le drop-shadow CSS
    multi-couches du logo + le contour noir text-shadow des paragraphes
    gèrent déjà la lisibilité sur la vidéo de fond.
  */

  /*
    Mise en page de l'accueil. Téléphone d'abord (maquette 390 px validée) :
    crâne réduit, logo, accroche, les deux actions principales empilées, puis
    une grille 2 colonnes de liens secondaires ; la citation et les chiffres
    passent sous les boutons. Bureau : même logique, actions côte à côte et
    liens secondaires sur deux lignes équilibrées (3 + 3).
  */
  .landing {
    position: relative;
    z-index: 10;
    min-height: 92svh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: flex-start;
    text-align: center;
    padding: 1.1rem 1.15rem 4.5rem;
  }
  @media (min-width: 640px) {
    .landing {
      justify-content: center;
      padding: 2.5rem 1.5rem 4rem;
    }
  }

  .landing-tagline {
    margin-top: 0.8rem;
    max-width: 48rem;
    font-size: 1rem;
    line-height: 1.4;
    font-style: italic;
  }
  @media (min-width: 640px) {
    .landing-tagline { margin-top: 1.6rem; font-size: 1.125rem; line-height: 1.55; }
  }

  .landing-nav {
    width: 100%;
    max-width: 40rem;
    margin-top: 1.1rem;
  }
  @media (min-width: 640px) {
    .landing-nav { margin-top: 2rem; }
  }
  .landing-primary {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }
  @media (min-width: 640px) {
    .landing-primary { flex-direction: row; gap: 0.8rem; }
    .landing-primary .cta { flex: 1 1 0; }
  }
  .landing-secondary {
    list-style: none;
    margin: 0.6rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0.5rem;
  }
  @media (min-width: 640px) {
    .landing-secondary { grid-template-columns: repeat(3, minmax(0, 1fr)); margin-top: 0.8rem; gap: 0.6rem; }
  }

  /* Action principale : la seule pleine. Action secondaire : contour. */
  .cta {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 3rem;
    padding: 0.6rem 1.1rem;
    border-radius: 4px;
    border: 2px solid #ffc879;
    font-family: var(--font-display);
    font-size: 0.82rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    text-decoration: none;
    font-weight: 700;
    transition: transform 200ms ease, box-shadow 220ms ease, background 220ms ease, color 200ms ease, border-color 200ms ease;
  }
  .cta:hover { transform: translateY(-2px); }
  .cta-primary {
    background: #ffc879;
    color: #0d0a06;
  }
  .cta-primary:hover {
    background: #ffe2a8;
    border-color: #ffe2a8;
    box-shadow: 0 0 0 1px #ffe2a8, 0 0 32px rgba(255, 200, 121, 0.7);
  }
  .cta-outline {
    color: #ffc879;
    background: rgba(13, 10, 6, 0.32);
    backdrop-filter: blur(6px);
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.95);
  }
  .cta-outline:hover {
    color: #ffe2a8;
    border-color: #ffe2a8;
    background: rgba(13, 10, 6, 0.55);
    box-shadow: 0 0 0 1px #ffe2a8, 0 0 32px rgba(255, 200, 121, 0.7);
  }

  /* Liens secondaires : plus discrets, cible tactile ≥ 44 px. */
  .cta-link {
    display: flex;
    align-items: center;
    justify-content: center;
    min-height: 2.6rem;
    height: 100%;
    padding: 0.35rem 0.5rem;
    border: 1px solid rgba(255, 200, 121, 0.5);
    border-radius: 4px;
    background: rgba(13, 10, 6, 0.32);
    backdrop-filter: blur(6px);
    color: #ebd9c5;
    font-family: var(--font-display);
    font-size: 0.78rem;
    letter-spacing: 0.06em;
    line-height: 1.2;
    text-decoration: none;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.95);
    transition: color 200ms ease, border-color 200ms ease, background 220ms ease, box-shadow 220ms ease;
  }
  @media (max-width: 639px) {
    /* 2 colonnes de ~170 px : « Carte paléo-monde » tient sur une ligne. */
    .cta-link { font-size: 0.72rem; letter-spacing: 0.03em; }
  }
  .cta-link:hover {
    color: #fff5e2;
    border-color: #ffc879;
    background: rgba(13, 10, 6, 0.55);
    box-shadow: 0 0 0 1px #ffc879, 0 0 22px rgba(255, 200, 121, 0.5);
  }
  .cta:focus-visible,
  .cta-link:focus-visible {
    outline: 3px solid #fff5e2;
    outline-offset: 3px;
  }

  .landing-sub {
    margin-top: 1.6rem;
    max-width: 36rem;
    font-size: 1rem;
    line-height: 1.5;
    font-style: italic;
  }

  .landing-stats {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.7rem;
    margin-top: 1.5rem;
  }
  .landing-stats span {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    min-height: 2.1rem;
    padding: 0.35rem 0.8rem;
    border: 1px solid rgba(255, 200, 121, 0.35);
    border-radius: 4px;
    background: rgba(13, 10, 6, 0.48);
    color: #fff5e2;
    font-family: var(--font-display);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.95);
  }
  .landing-stats strong {
    color: var(--color-evato-amber-bright);
    font-size: 1rem;
    letter-spacing: 0.04em;
  }

  /* Le wordmark SVG porte le nom accessible du <h1> ; le titre ne doit rien
     ajouter visuellement (marges et typo du h1 neutralisées). */
  .landing-title {
    width: 500px;
    max-width: 100%;
    margin: 0;
    line-height: 0;
    letter-spacing: normal;
  }

  /* Skull au-dessus du logo — réduit à ~140 px au téléphone (maquette). */
  .landing-skull {
    margin-bottom: 0.5rem;
    filter: drop-shadow(0 0 12px rgba(255, 234, 0, 0.4));
  }
  @media (max-width: 639px) {
    .landing-skull { margin-bottom: 0.25rem; }
    .landing-skull :global(.evato-skull) { width: 140px; height: 77px; }
  }

  /*
    Texte landing en blanc pur + contour noir épais (effet sous-titres TV)
    pour rester ultra-lisible sur les zones lumineuses des MP4. Pas
    d'italique fade : weight 600, contour 4-direction 1px, glow ambre
    derrière.
  */
  .landing-tagline,
  .landing-sub {
    color: #ffffff !important;
    text-shadow:
      -1.5px -1.5px 0 rgba(0, 0, 0, 0.95),
       1.5px -1.5px 0 rgba(0, 0, 0, 0.95),
      -1.5px  1.5px 0 rgba(0, 0, 0, 0.95),
       1.5px  1.5px 0 rgba(0, 0, 0, 0.95),
       0 0 12px rgba(0, 0, 0, 0.85),
       0 0 28px rgba(255, 200, 121, 0.45);
    font-weight: 600;
  }
  .landing-sub {
    color: #ffe2a8 !important;
  }

  /*
    main::before retiré — c'était le coupable du foreground palichon
    (Sylvain 2026-05-07). Le radial-gradient au centre 50%/50% en
    rgba(13, 10, 6, 0.7) désaturait tout le logo et le texte qui
    passaient à travers. Le drop-shadow CSS du logo + text-shadow épais
    des paragraphes gèrent déjà la lisibilité sur les zones lumineuses
    de la vidéo de fond.
  */

  /* Legacy CSS hero-grid kept only as no-op fallback (composant retiré). */
  .hero-grid { display: contents; }
  .hero-image {
    position: relative;
    margin: 0;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid rgba(212, 165, 94, 0.35);
    box-shadow:
      0 0 0 1px rgba(13, 10, 6, 0.5),
      0 24px 48px -16px rgba(0, 0, 0, 0.65),
      0 0 60px -20px rgba(212, 165, 94, 0.4);
    aspect-ratio: 4 / 3;
    display: none; /* hero-image n'est plus utilisé sur la landing */
  }
  .hero-image::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse at 60% 20%, transparent 30%, rgba(13, 10, 6, 0.35) 90%),
      linear-gradient(to bottom, transparent 70%, rgba(13, 10, 6, 0.65) 100%);
  }
  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: saturate(1.05) contrast(1.02);
    animation: hero-breathe 14s ease-in-out infinite;
  }
  @keyframes hero-breathe {
    0%, 100% { transform: scale(1); }
    50%      { transform: scale(1.025); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-image img { animation: none; }
  }
  .hero-image figcaption {
    position: absolute;
    bottom: 0.9rem;
    left: 1.1rem;
    right: 1.1rem;
    z-index: 2;
    font-family: var(--font-body);
    font-style: italic;
    font-size: 1rem;
    color: var(--color-evato-bone);
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.85);
    letter-spacing: 0.02em;
  }

  /* Côté droit : alignement gauche pour matcher la grille, logo gauche aussi. */
  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
  }
  @media (max-width: 960px) {
    .hero-content {
      align-items: center;
      text-align: center;
    }
  }
</style>
