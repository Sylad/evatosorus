---
import BaseLayout from '../layouts/BaseLayout.astro';
import EvatoLogo from '../components/EvatoLogo.astro';
import EvatoSkull from '../components/EvatoSkull.astro';
import { HeroVideoCycle } from '../components/cinema/HeroVideoCycle';
import { DustField } from '../components/cinema/DustField';
import { SPECIES, getSpeciesVideos, TAXON_GROUP_LABELS } from '../data/species';

const showcaseIds = [
  'tyrannosaurus-rex',
  'triceratops-horridus',
  'velociraptor-mongoliensis',
  'brachiosaurus-altithorax',
  'stegosaurus-stenops',
  'spinosaurus-aegyptiacus',
] as const;

const featuredSpecies = showcaseIds
  .map((id) => SPECIES.find((species) => species.id === id))
  .filter(Boolean)
  .map((species) => ({
    ...species!,
    videos: getSpeciesVideos(species!.id),
  }));

const totalSpecies = SPECIES.length.toLocaleString('fr-FR');
---
<BaseLayout
  title="Evatosorus — Codex Mésozoïque"
  description="Un codex visuel des dinosaures — Trias, Jurassique, Crétacé. 1500+ espèces, paleo-art domaine public."
>
  <!--
    Landing — full-viewport background video. Trois couches :
      1. HeroVideoCycle : 3 MP4 openart.ai (T-Rex jungle/volcan/orage)
         empilés en background fixed, cross-fade toutes les 25s.
      2. DustField : poussière ambre/cendre par-dessus la vidéo.
      3. Voile sombre gradient (main::before) pour la lisibilité du logo.
    Le contenu (logo + tagline + CTAs) flotte au centre sur la vidéo.
  -->
  <HeroVideoCycle client:only="react" />
  <DustField client:only="react" />

  <main class="relative z-10 min-h-[92svh] flex flex-col items-center justify-center text-center px-6 pt-10 pb-16">
    <div class="landing-skull"><EvatoSkull size={300} /></div>
    <EvatoLogo size={500} />

    <p class="mt-8 max-w-3xl text-evato-bone text-lg italic font-body landing-tagline" data-amber-split>
      <span class="font-semibold not-italic">Evatosorus</span> — un musée vivant
      du Mésozoïque pour Eva, entre scènes de vie, fossiles, cartes et créatures
      qui ont vraiment habité la Terre.
    </p>

    <p class="mt-4 max-w-xl text-evato-bone-muted text-base italic font-body landing-sub" data-amber-split>
      « Avant nous, il y a eu eux. »<br/>
      Trias, Jurassique, Crétacé. {totalSpecies} espèces, des paysages perdus
      et quelques géants remis en mouvement.
    </p>

    <div class="landing-stats" aria-label="Aperçu du contenu Evatosorus">
      <span><strong>{totalSpecies}</strong> espèces</span>
      <span><strong>10</strong> scènes animées</span>
      <span><strong>3</strong> ères à explorer</span>
    </div>

    <div class="mt-10 flex flex-wrap gap-3 justify-center landing-ctas">
      <a href="/vitrines/" class="cta cta-amber">Espèces vitrines</a>
      <a href="/codex/" class="cta cta-amber">Explorer le codex</a>
      <a href="/periodes/" class="cta cta-jade">Voyage temporel</a>
      <a href="/carte/" class="cta cta-rust">Carte paléo-monde</a>
      <a href="/films/" class="cta cta-bone">Films</a>
      <a href="/videos/" class="cta cta-bone">Vidéos YouTube</a>
      <a href="/about/" class="cta cta-ghost">À propos</a>
    </div>
  </main>

  <section class="showcase-section" aria-labelledby="showcase-title">
    <div class="showcase-copy">
      <p class="section-kicker">Espèces vitrines</p>
      <h2 id="showcase-title">Des fiches qui respirent, pas seulement des noms latins.</h2>
      <p data-amber-split>
        Les espèces les plus connues ouvrent le musée : une scène de vie, une
        animation courte, puis une fiche plus calme pour comprendre ce qu'on sait
        vraiment d'elles.
      </p>
    </div>

    <div class="showcase-grid">
      {featuredSpecies.map((species, index) => (
        <a class="showcase-card tap-bloom" href={`/especes/${species.id}/`}>
          <div class="showcase-media">
            {species.videos[0] ? (
              <video
                src={species.videos[index % species.videos.length]}
                poster={species.lifeRestorationUrl ?? species.imageUrl}
                autoplay
                muted
                loop
                playsinline
                preload="metadata"
              />
            ) : (
              <img
                src={species.lifeRestorationUrl ?? species.imageUrl}
                alt={species.commonName ?? species.name}
                loading="lazy"
                decoding="async"
              />
            )}
          </div>
          <div class="showcase-body">
            <span>{TAXON_GROUP_LABELS[species.taxonGroup] ?? species.taxonGroup}</span>
            <h3>{species.commonName ?? species.name}</h3>
            <p>{species.name}</p>
          </div>
        </a>
      ))}
    </div>
  </section>
</BaseLayout>

<script is:inline>
  // Wraps each word in [data-amber-split] paragraphs in <span class="amber-word">
  // so the cursor can light up individual words in fossil-amber.
  (() => {
    if (typeof window === 'undefined') return;
    const split = () => {
      const targets = document.querySelectorAll('[data-amber-split]');
      targets.forEach((p) => {
        if (p.dataset.amberSplitDone === '1') return;
        Array.from(p.childNodes).forEach((node) => {
          if (node.nodeType !== Node.TEXT_NODE) return;
          const text = node.textContent ?? '';
          if (!text.trim()) return;
          const frag = document.createDocumentFragment();
          text.split(/(\s+)/).forEach((tok) => {
            if (/^\s+$/.test(tok) || tok === '') {
              frag.appendChild(document.createTextNode(tok));
            } else {
              const span = document.createElement('span');
              span.className = 'amber-word';
              span.textContent = tok;
              frag.appendChild(span);
            }
          });
          p.replaceChild(frag, node);
        });
        p.dataset.amberSplitDone = '1';
      });
    };
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', split);
    } else {
      split();
    }
    document.addEventListener('astro:page-load', split);
  })();
</script>

<style>
  /*
    PAS de voile main::before sur la landing : le radial-gradient dark
    précédent (rgba 0.7 au centre) tuait toute la saturation du logo et
    du texte. Sylvain l'a identifié 2026-05-07. Le drop-shadow CSS
    multi-couches du logo + le contour noir text-shadow des paragraphes
    gèrent déjà la lisibilité sur la vidéo de fond.
  */

  /*
    CTAs landing : retour au design border + texte coloré (préféré par Sylvain),
    mais avec couleurs vraiment saturées et fond opaque pour ressortir sur la
    vidéo de fond.
  */
  .cta {
    padding: 0.7rem 1.3rem;
    border-radius: 4px;
    border: 2px solid;
    font-family: var(--font-display);
    font-size: 0.82rem;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    text-decoration: none;
    background: rgba(13, 10, 6, 0.32);
    backdrop-filter: blur(6px);
    transition: transform 200ms ease, box-shadow 220ms ease, background 220ms ease, color 200ms ease, border-color 200ms ease;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.95);
    font-weight: 700;
  }
  .cta:hover {
    transform: translateY(-2px);
    background: rgba(13, 10, 6, 0.55);
  }
  .cta-amber {
    border-color: #ffc879;
    color: #ffc879;
  }
  .cta-amber:hover {
    color: #ffe2a8;
    border-color: #ffe2a8;
    box-shadow: 0 0 0 1px #ffe2a8, 0 0 32px rgba(255, 200, 121, 0.7);
  }
  .cta-jade {
    border-color: #7fd194;
    color: #7fd194;
  }
  .cta-jade:hover {
    color: #a3e8b3;
    border-color: #a3e8b3;
    box-shadow: 0 0 0 1px #a3e8b3, 0 0 28px rgba(127, 209, 148, 0.65);
  }
  .cta-rust {
    border-color: #ff7a4a;
    color: #ff7a4a;
  }
  .cta-rust:hover {
    color: #ff9c70;
    border-color: #ff9c70;
    box-shadow: 0 0 0 1px #ff9c70, 0 0 30px rgba(255, 122, 74, 0.7);
  }
  .cta-bone {
    border-color: #ebd9c5;
    color: #ebd9c5;
  }
  .cta-bone:hover {
    color: #fff5e2;
    border-color: #fff5e2;
    box-shadow: 0 0 0 1px #fff5e2, 0 0 24px rgba(232, 230, 221, 0.55);
  }
  .cta-ghost {
    background: rgba(13, 10, 6, 0.22);
    border-color: rgba(212, 165, 94, 0.45);
    color: #b8a78f;
  }
  .cta-ghost:hover {
    background: rgba(13, 10, 6, 0.45);
    border-color: #ffc879;
    color: #fff5e2;
    box-shadow: 0 0 0 1px #ffc879, 0 0 22px rgba(255, 200, 121, 0.5);
  }

  .landing-stats {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.7rem;
    margin-top: 1.5rem;
  }
  .landing-stats span {
    display: inline-flex;
    align-items: baseline;
    gap: 0.35rem;
    min-height: 2.1rem;
    padding: 0.35rem 0.8rem;
    border: 1px solid rgba(255, 200, 121, 0.35);
    border-radius: 4px;
    background: rgba(13, 10, 6, 0.48);
    color: #fff5e2;
    font-family: var(--font-display);
    font-size: 0.68rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    text-shadow: 0 1px 4px rgba(0, 0, 0, 0.95);
  }
  .landing-stats strong {
    color: var(--color-evato-amber-bright);
    font-size: 1rem;
    letter-spacing: 0.04em;
  }

  .showcase-section {
    position: relative;
    z-index: 10;
    display: grid;
    grid-template-columns: minmax(0, 0.72fr) minmax(0, 1.28fr);
    gap: clamp(1.5rem, 4vw, 4rem);
    align-items: start;
    padding: clamp(3rem, 7vw, 6rem) clamp(1rem, 4vw, 4rem) clamp(4rem, 8vw, 7rem);
    background:
      linear-gradient(180deg, rgba(13, 10, 6, 0.1) 0%, rgba(13, 10, 6, 0.92) 18%, #0d0a06 100%),
      radial-gradient(ellipse at 18% 30%, rgba(212, 165, 94, 0.16), transparent 52%),
      radial-gradient(ellipse at 88% 12%, rgba(94, 143, 110, 0.12), transparent 46%);
    border-top: 1px solid rgba(255, 200, 121, 0.18);
  }
  .showcase-copy {
    position: sticky;
    top: 2rem;
    max-width: 34rem;
  }
  .section-kicker {
    margin: 0 0 0.7rem;
    color: var(--color-evato-amber-bright);
    font-family: var(--font-display);
    font-size: 0.72rem;
    letter-spacing: 0.24em;
    text-transform: uppercase;
  }
  .showcase-copy h2 {
    margin: 0;
    color: #fff5e2;
    font-size: clamp(2rem, 4vw, 3.4rem);
    line-height: 1.05;
    letter-spacing: 0.03em;
    text-shadow: 0 0 24px rgba(0, 0, 0, 0.7);
  }
  .showcase-copy p:last-child {
    margin-top: 1.2rem;
    color: var(--color-evato-bone-muted);
    font-size: 1.12rem;
    line-height: 1.6;
  }
  .showcase-grid {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.85rem;
  }
  .showcase-card {
    min-width: 0;
    overflow: hidden;
    border: 1px solid rgba(212, 165, 94, 0.22);
    border-radius: 6px;
    background: rgba(26, 18, 10, 0.72);
    color: inherit;
    text-decoration: none;
    transition: transform 220ms ease, border-color 220ms ease, box-shadow 220ms ease;
  }
  .showcase-card:hover {
    transform: translateY(-4px);
    border-color: rgba(255, 200, 121, 0.72);
    box-shadow: 0 22px 42px -24px rgba(255, 200, 121, 0.65);
  }
  .showcase-media {
    aspect-ratio: 4 / 5;
    background: #140e08;
    overflow: hidden;
  }
  .showcase-media video,
  .showcase-media img {
    width: 100%;
    height: 100%;
    display: block;
    object-fit: cover;
    filter: saturate(0.92) contrast(1.04) brightness(0.9);
    transition: transform 5s ease, filter 220ms ease;
  }
  .showcase-card:hover .showcase-media video,
  .showcase-card:hover .showcase-media img {
    transform: scale(1.05);
    filter: saturate(1.08) contrast(1.05) brightness(1);
  }
  .showcase-body {
    padding: 0.85rem 0.95rem 1rem;
  }
  .showcase-body span {
    color: var(--color-evato-jade);
    font-family: var(--font-display);
    font-size: 0.58rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
  }
  .showcase-body h3 {
    margin: 0.28rem 0 0;
    color: var(--color-evato-amber-bright);
    font-size: 1rem;
    line-height: 1.15;
    letter-spacing: 0.03em;
  }
  .showcase-body p {
    margin: 0.18rem 0 0;
    color: var(--color-evato-bone-muted);
    font-size: 0.82rem;
    font-style: italic;
    line-height: 1.25;
  }

  @media (max-width: 1040px) {
    .showcase-section {
      grid-template-columns: 1fr;
    }
    .showcase-copy {
      position: static;
      max-width: 44rem;
    }
  }

  @media (max-width: 760px) {
    .showcase-grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .showcase-section {
      padding-inline: 1rem;
    }
  }

  @media (max-width: 460px) {
    .showcase-grid {
      grid-template-columns: 1fr;
    }
    .showcase-media {
      aspect-ratio: 16 / 10;
    }
  }

  /* Skull au-dessus du logo */
  .landing-skull {
    margin-bottom: 0.5rem;
    filter: drop-shadow(0 0 12px rgba(255, 234, 0, 0.4));
  }

  /*
    Texte landing en blanc pur + contour noir épais (effet sous-titres TV)
    pour rester ultra-lisible sur les zones lumineuses des MP4. Pas
    d'italique fade : weight 600, contour 4-direction 1px, glow ambre
    derrière.
  */
  .landing-tagline,
  .landing-sub {
    color: #ffffff !important;
    text-shadow:
      -1.5px -1.5px 0 rgba(0, 0, 0, 0.95),
       1.5px -1.5px 0 rgba(0, 0, 0, 0.95),
      -1.5px  1.5px 0 rgba(0, 0, 0, 0.95),
       1.5px  1.5px 0 rgba(0, 0, 0, 0.95),
       0 0 12px rgba(0, 0, 0, 0.85),
       0 0 28px rgba(255, 200, 121, 0.45);
    font-weight: 600;
  }
  .landing-tagline .font-semibold {
    color: #ffe2a8 !important;
    font-weight: 800;
  }
  .landing-sub {
    color: #ffe2a8 !important;
  }

  /*
    main::before retiré — c'était le coupable du foreground palichon
    (Sylvain 2026-05-07). Le radial-gradient au centre 50%/50% en
    rgba(13, 10, 6, 0.7) désaturait tout le logo et le texte qui
    passaient à travers. Le drop-shadow CSS du logo + text-shadow épais
    des paragraphes gèrent déjà la lisibilité sur les zones lumineuses
    de la vidéo de fond.
  */

  /* Legacy CSS hero-grid kept only as no-op fallback (composant retiré). */
  .hero-grid { display: contents; }
  .hero-image {
    position: relative;
    margin: 0;
    border-radius: 8px;
    overflow: hidden;
    border: 1px solid rgba(212, 165, 94, 0.35);
    box-shadow:
      0 0 0 1px rgba(13, 10, 6, 0.5),
      0 24px 48px -16px rgba(0, 0, 0, 0.65),
      0 0 60px -20px rgba(212, 165, 94, 0.4);
    aspect-ratio: 4 / 3;
    display: none; /* hero-image n'est plus utilisé sur la landing */
  }
  .hero-image::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      radial-gradient(ellipse at 60% 20%, transparent 30%, rgba(13, 10, 6, 0.35) 90%),
      linear-gradient(to bottom, transparent 70%, rgba(13, 10, 6, 0.65) 100%);
  }
  .hero-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    filter: saturate(1.05) contrast(1.02);
    animation: hero-breathe 14s ease-in-out infinite;
  }
  @keyframes hero-breathe {
    0%, 100% { transform: scale(1); }
    50%      { transform: scale(1.025); }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero-image img { animation: none; }
  }
  .hero-image figcaption {
    position: absolute;
    bottom: 0.9rem;
    left: 1.1rem;
    right: 1.1rem;
    z-index: 2;
    font-family: var(--font-body);
    font-style: italic;
    font-size: 1rem;
    color: var(--color-evato-bone);
    text-shadow: 0 1px 6px rgba(0, 0, 0, 0.85);
    letter-spacing: 0.02em;
  }

  /* Côté droit : alignement gauche pour matcher la grille, logo gauche aussi. */
  .hero-content {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
  }
  @media (max-width: 960px) {
    .hero-content {
      align-items: center;
      text-align: center;
    }
  }
</style>
