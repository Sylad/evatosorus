---
import CodexLayout from '../../layouts/CodexLayout.astro';
import { SPECIES, getSpeciesById, getSpeciesVideos, TAXON_GROUP_LABELS, DIET_LABELS, DIET_ICONS } from '../../data/species';
import { PERIODS_BY_ID } from '../../data/periods';

export function getStaticPaths() {
  return SPECIES.map((s) => ({ params: { id: s.id } }));
}

const { id } = Astro.params;
const s = getSpeciesById(id!);
if (!s) return Astro.redirect('/codex/');

const period = PERIODS_BY_ID[s.periodId];
const otherSameGroup = SPECIES
  .filter((x) => x.taxonGroup === s.taxonGroup && x.id !== s.id)
  .slice(0, 6);
const videos = getSpeciesVideos(s.id);
const activeMa = s.earlyMa && s.lateMa ? Math.abs(s.earlyMa - s.lateMa) : undefined;
const massTonnes = s.weightKg ? s.weightKg / 1000 : undefined;
const scaleNote = s.lengthM && s.lengthM >= 25
  ? 'Une silhouette de la longueur d’un petit immeuble couché.'
  : s.lengthM && s.lengthM >= 10
    ? 'Un animal de grande taille, à imaginer comme une masse vivante occupant toute une rue.'
    : s.lengthM && s.lengthM <= 1
      ? 'Un format miniature à l’échelle du Mésozoïque, plus proche d’un animal discret que d’un monstre de cinéma.'
      : s.lengthM
        ? 'Une présence à hauteur d’animal sauvage, lisible à l’échelle humaine.'
        : undefined;
const worldNote = s.taxonGroup === 'marine-reptile'
  ? 'Son monde n’était pas une plaine de dinosaures, mais les mers chaudes du Mésozoïque.'
  : s.taxonGroup === 'pterosaur'
    ? 'Il occupait le ciel et les falaises, au-dessus des mêmes paysages que les dinosaures.'
    : s.diet === 'piscivore'
      ? 'Son histoire se lit près de l’eau : rivières, lagunes ou mers intérieures.'
      : s.diet === 'herbivore'
        ? 'Son quotidien se jouait dans les plantes, les pistes de troupeaux et les refuges contre les prédateurs.'
        : s.diet === 'carnivore'
          ? 'Son rôle était celui d’un prédateur, mais aussi d’un régulateur d’écosystème.'
          : 'Son mode de vie reste une fenêtre ouverte sur un monde très incomplet.';
const fieldNotes = [
  activeMa && {
    label: 'Fenêtre fossile',
    value: `${activeMa.toLocaleString('fr-FR', { maximumFractionDigits: 1 })} million${activeMa > 1 ? 's' : ''} d’années entre les repères connus.`,
  },
  massTonnes && {
    label: 'Masse vivante',
    value: `${massTonnes.toLocaleString('fr-FR', { maximumFractionDigits: 1 })} tonne${massTonnes > 1 ? 's' : ''} environ, d’après les estimations retenues ici.`,
  },
  scaleNote && {
    label: 'Échelle',
    value: scaleNote,
  },
  worldNote && {
    label: 'Monde probable',
    value: worldNote,
  },
].filter((note): note is { label: string; value: string } => Boolean(note));
const showcaseInsights: Record<string, { label: string; title: string; text: string }[]> = {
  'tyrannosaurus-rex': [
    {
      label: 'fiction vs science',
      title: 'Pas seulement un monstre de cinéma',
      text: 'T. rex était un prédateur capable, mais aussi un animal opportuniste : comme les grands carnivores actuels, il pouvait chasser, voler une carcasse ou profiter d’un animal déjà affaibli.',
    },
    {
      label: 'pourquoi il est célèbre',
      title: 'L’icône absolue',
      text: 'Sa taille, son crâne massif et son nom spectaculaire en ont fait le dinosaure le plus reconnaissable du monde, bien au-delà des musées.',
    },
  ],
  'triceratops-horridus': [
    {
      label: 'à ne pas réduire',
      title: 'Plus qu’un rival de T. rex',
      text: 'Ses cornes et sa collerette servaient probablement autant aux parades, aux signaux sociaux et aux affrontements entre individus qu’à la défense contre les prédateurs.',
    },
  ],
  'velociraptor-mongoliensis': [
    {
      label: 'fiction vs science',
      title: 'Beaucoup plus petit que dans Jurassic Park',
      text: 'Le vrai Velociraptor avait plutôt la taille d’un grand dindon, avec des plumes. Les “raptors” géants du cinéma ressemblent davantage à Deinonychus ou Utahraptor.',
    },
  ],
  'brachiosaurus-altithorax': [
    {
      label: 'échelle',
      title: 'Une girafe du Jurassique, mais en version colosse',
      text: 'Ses membres antérieurs plus longs que les postérieurs lui donnaient une posture très haute, utile pour atteindre une végétation inaccessible à beaucoup d’autres herbivores.',
    },
  ],
  'stegosaurus-stenops': [
    {
      label: 'mystère',
      title: 'Des plaques pas faites pour mordre',
      text: 'Les grandes plaques dorsales étaient probablement liées à l’affichage visuel, à la reconnaissance ou à la régulation thermique, plus qu’à une armure purement défensive.',
    },
  ],
  'spinosaurus-aegyptiacus': [
    {
      label: 'science mouvante',
      title: 'Un dinosaure en débat permanent',
      text: 'Spinosaurus est l’un des dinosaures les plus réinterprétés : voile dorsale, queue nageuse, posture, mode de chasse. Sa silhouette raconte aussi l’évolution des connaissances.',
    },
  ],
  'ankylosaurus-magniventris': [
    {
      label: 'défense',
      title: 'Un blindé vivant',
      text: 'Ses plaques osseuses et sa massue caudale en faisaient un herbivore difficile à attaquer. Sa stratégie n’était pas la vitesse, mais la résistance.',
    },
  ],
  'parasaurolophus-walkeri': [
    {
      label: 'son',
      title: 'Une crête qui pouvait résonner',
      text: 'Sa longue crête creuse a pu servir de caisse de résonance, produisant des sons graves utiles pour communiquer à distance dans les troupeaux.',
    },
  ],
  'allosaurus-fragilis': [
    {
      label: 'avant T. rex',
      title: 'Le grand prédateur du Jurassique',
      text: 'Allosaurus a dominé bien avant T. rex. Sa tête plus légère et ses bras plus utiles lui donnaient une silhouette de chasseur très différente.',
    },
  ],
  'diplodocus-carnegii': [
    {
      label: 'anatomie',
      title: 'Une longueur presque irréelle',
      text: 'Diplodocus devait beaucoup de sa taille à un cou et une queue immenses. Son corps, lui, restait relativement léger pour un sauropode.',
    },
  ],
  'iguanodon-bernissartensis': [
    {
      label: 'histoire des sciences',
      title: 'L’un des premiers dinosaures nommés',
      text: 'Iguanodon fait partie des dinosaures fondateurs de la paléontologie. Son fameux “pouce” a longtemps été mal interprété comme une corne sur le nez.',
    },
  ],
  'carnotaurus-sastrei': [
    {
      label: 'silhouette',
      title: 'Le taureau carnivore',
      text: 'Ses petites cornes et ses bras extrêmement réduits lui donnent une silhouette immédiatement reconnaissable, très différente des grands théropodes nord-américains.',
    },
  ],
  'giganotosaurus-carolinii': [
    {
      label: 'comparaison',
      title: 'Pas “un T. rex plus grand”, autre chose',
      text: 'Giganotosaurus appartenait à une autre lignée de grands carnivores. Son crâne long et ses dents tranchantes évoquent une stratégie de morsures profondes plutôt que d’écrasement.',
    },
  ],
  'deinonychus-antirrhopus': [
    {
      label: 'impact scientifique',
      title: 'Le raptor qui a changé l’image des dinosaures',
      text: 'Deinonychus a aidé à imposer l’idée de dinosaures actifs, agiles et proches des oiseaux, loin de l’ancienne image d’animaux lourds et lents.',
    },
  ],
  'pachycephalosaurus-wyomingensis': [
    {
      label: 'hypothèse',
      title: 'Le crâne-dôme reste discuté',
      text: 'Son crâne épaissi évoque des combats tête contre tête, mais les paléontologues discutent encore la façon exacte dont il s’en servait.',
    },
  ],
  'therizinosaurus-cheloniformis': [
    {
      label: 'étrangeté',
      title: 'Des griffes absurdes pour un régime paisible',
      text: 'Malgré ses griffes géantes, Therizinosaurus était probablement herbivore ou omnivore. Son apparence rappelle que l’évolution ne cherche pas à faire simple.',
    },
  ],
  'argentinosaurus-huinculensis': [
    {
      label: 'limite des estimations',
      title: 'Le géant qu’on mesure avec prudence',
      text: 'Argentinosaurus est connu par des fossiles incomplets. Les estimations de taille varient, mais il reste parmi les plus grands animaux terrestres envisagés.',
    },
  ],
  'mosasaurus-hoffmanni': [
    {
      label: 'à ne pas confondre',
      title: 'Un reptile marin, pas un dinosaure',
      text: 'Mosasaurus vivait dans les mers du Crétacé. Il partage l’époque des dinosaures, mais n’appartient pas à leur groupe.',
    },
  ],
  'pteranodon-longiceps': [
    {
      label: 'à ne pas confondre',
      title: 'Un ptérosaure, pas un dinosaure volant',
      text: 'Pteranodon appartient aux reptiles volants. Les dinosaures volants, au sens strict, ce sont les oiseaux.',
    },
  ],
  'archaeopteryx-lithographica': [
    {
      label: 'transition',
      title: 'Une fenêtre vers l’origine des oiseaux',
      text: 'Archaeopteryx mélange plumes, ailes, dents, griffes et longue queue osseuse. Il montre que l’histoire des oiseaux commence au cœur des dinosaures théropodes.',
    },
  ],
};
const generalInsight = s.taxonGroup === 'pterosaur'
  ? {
      label: 'classification',
      title: 'Pas un dinosaure, mais un voisin du même monde',
      text: 'Les ptérosaures sont des reptiles volants distincts. Ils vivaient aux côtés des dinosaures, sans faire partie du même groupe.',
    }
  : s.taxonGroup === 'marine-reptile'
    ? {
        label: 'classification',
        title: 'Pas un dinosaure marin',
        text: 'Les dinosaures sont des animaux terrestres au sens strict. Les grands reptiles marins du Mésozoïque appartiennent à d’autres lignées.',
      }
    : undefined;
const speciesInsights = [
  ...(showcaseInsights[s.id] ?? []),
  ...(generalInsight && !showcaseInsights[s.id]?.some((insight) => insight.label === 'classification') ? [generalInsight] : []),
];
---
<CodexLayout
  title={`${s.commonName ?? s.name} — Evatosorus`}
  description={s.blurb ?? `${s.name}, un ${TAXON_GROUP_LABELS[s.taxonGroup] ?? ''} du ${period?.name ?? 'Mésozoïque'}.`}
  active="codex"
>
  <a href="/codex/" class="back-link">← Codex</a>

  <article class="species-detail">
    <header class="detail-header">
      <p class="codex-eyebrow" style={`--accent:${period?.accentColor ?? '#d4a55e'}`}>
        {TAXON_GROUP_LABELS[s.taxonGroup]} · {period?.name ?? 'Mésozoïque'}
      </p>
      <h1>{s.commonName ?? s.name}</h1>
      <p class="sci-name">{s.name}</p>
    </header>

    <div class="detail-grid">
      <div class="detail-image" data-lightbox>
        {/* Image principale = paleo-art "en chair" si dispo, sinon le squelette/fossile. */}
        {(s.lifeRestorationUrl || s.imageUrl) ? (
          <img
            src={s.lifeRestorationUrl ?? s.imageUrl}
            alt={s.commonName ?? s.name}
          />
        ) : (
          <div class="image-fallback"><span>𓆗</span></div>
        )}
        <p class="image-caption">
          {s.lifeRestorationUrl ? 'Reconstitution paleo-art' : 'Référence muséale'}
          {s.lifeRestorationCredit && <span class="image-credit"> · © {s.lifeRestorationCredit}</span>}
          {!s.lifeRestorationUrl && s.imageCredit && <span class="image-credit"> · © {s.imageCredit}</span>}
        </p>
        {/* Image secondaire : squelette/fossile, affiché sous l'image principale si on a aussi un paleo-art. */}
        {s.lifeRestorationUrl && s.imageUrl && (
          <div class="detail-secondary">
            <img src={s.imageUrl} alt={`Squelette ou fossile de ${s.commonName ?? s.name}`} loading="lazy" />
            <p class="image-caption">
              Squelette / fossile
              {s.imageCredit && <span class="image-credit"> · © {s.imageCredit}</span>}
            </p>
          </div>
        )}
      </div>

      <aside class="detail-stats">
        <dl>
          <dt>Régime</dt>
          <dd>{DIET_ICONS[s.diet]} {DIET_LABELS[s.diet]}</dd>
          {s.lengthM && (<><dt>Longueur</dt><dd>{s.lengthM} m</dd></>)}
          {s.heightM && s.heightM > 0 && (<><dt>Hauteur</dt><dd>{s.heightM} m</dd></>)}
          {s.weightKg && (<><dt>Poids</dt><dd>{(s.weightKg / 1000).toLocaleString('fr-FR', { maximumFractionDigits: 1 })} t</dd></>)}
          {s.earlyMa && s.lateMa && (<><dt>Existence</dt><dd>{s.earlyMa} → {s.lateMa} Ma</dd></>)}
          <dt>Période</dt>
          <dd><a href={`/periodes/${s.periodId}/`}>{period?.name ?? '?'}</a></dd>
          {s.locations && s.locations.length > 0 && (
            <>
              <dt>Régions</dt>
              <dd>{s.locations.map((l) => l.country).join(', ')}</dd>
            </>
          )}
        </dl>
      </aside>
    </div>

    {s.blurb && (
      <section class="detail-blurb" data-amber-split>
        <p>{s.blurb}</p>
      </section>
    )}

    {fieldNotes.length > 0 && (
      <section class="field-notes">
        <p class="section-kicker">repères de terrain</p>
        <h2>Lire la créature en quelques indices.</h2>
        <div class="field-note-grid">
          {fieldNotes.map((note) => (
            <article>
              <h3>{note.label}</h3>
              <p>{note.value}</p>
            </article>
          ))}
        </div>
      </section>
    )}

    {speciesInsights.length > 0 && (
      <section class="insight-panel">
        <p class="section-kicker">à savoir</p>
        <h2>Le détail qui change le regard.</h2>
        <div class="insight-grid">
          {speciesInsights.map((insight) => (
            <article>
              <span>{insight.label}</span>
              <h3>{insight.title}</h3>
              <p>{insight.text}</p>
            </article>
          ))}
        </div>
      </section>
    )}

    {videos.length > 0 && (
      <section class="detail-videos">
        <h2>Galerie vidéo</h2>
        <p class="videos-caption">Reconstitutions animées — IA paleo-art (openart.ai).</p>
        <div class="videos-grid">
          {videos.map((src) => (
            <video
              src={src}
              autoplay
              muted
              loop
              playsinline
              controls
              preload="auto"
            />
          ))}
        </div>
      </section>
    )}

    {s.wikipediaUrl && (
      <p class="external">
        Lire la fiche complète sur <a href={s.wikipediaUrl} target="_blank" rel="noopener noreferrer">Wikipedia</a>.
      </p>
    )}

    {otherSameGroup.length > 0 && (
      <section class="related">
        <h2>Autres {TAXON_GROUP_LABELS[s.taxonGroup]?.toLowerCase()}</h2>
        <div class="related-grid">
          {otherSameGroup.map((o) => (
            <a href={`/especes/${o.id}/`} class="related-card">
              {o.imageUrl && <img src={o.imageUrl} alt={o.commonName ?? o.name} loading="lazy" />}
              <span class="related-name">{o.commonName ?? o.name}</span>
            </a>
          ))}
        </div>
      </section>
    )}
  </article>

  <script is:inline>
    (() => {
      const split = () => {
        document.querySelectorAll('[data-amber-split]').forEach((p) => {
          if (p.dataset.amberSplitDone === '1') return;
          Array.from(p.childNodes).forEach((node) => {
            if (node.nodeType !== Node.TEXT_NODE) return;
            const text = node.textContent ?? '';
            if (!text.trim()) return;
            const frag = document.createDocumentFragment();
            text.split(/(\s+)/).forEach((tok) => {
              if (/^\s+$/.test(tok) || tok === '') {
                frag.appendChild(document.createTextNode(tok));
              } else {
                const span = document.createElement('span');
                span.className = 'amber-word';
                span.textContent = tok;
                frag.appendChild(span);
              }
            });
            p.replaceChild(frag, node);
          });
          p.dataset.amberSplitDone = '1';
        });
      };
      // Re-run on Astro page transitions
      if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', split);
      else split();
      document.addEventListener('astro:page-load', split);

      // Recurse one level deeper to also split block children (paragraphs).
      const splitDeep = (root) => {
        root.querySelectorAll('p').forEach((p) => {
          if (!p.dataset.amberSplitDone && p.closest('[data-amber-split]')) {
            p.dataset.amberSplit = '1';
          }
        });
      };
      splitDeep(document);
    })();
  </script>

  <style>
    .back-link {
      font-family: var(--font-display);
      font-size: 0.75rem;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--color-evato-bone-muted);
      text-decoration: none;
      margin-bottom: 1.5rem;
      display: inline-block;
    }
    .back-link:hover { color: var(--color-evato-amber); }

    .detail-header {
      margin-bottom: 2rem;
    }
    .codex-eyebrow {
      font-family: var(--font-display);
      font-size: 0.72rem;
      letter-spacing: 0.32em;
      color: var(--accent);
      text-transform: uppercase;
      margin: 0 0 0.4rem;
    }
    .detail-header h1 {
      font-size: 3rem;
      margin: 0 0 0.3rem;
      color: var(--color-evato-amber-bright);
    }
    .sci-name {
      font-style: italic;
      font-size: 1.15rem;
      color: var(--color-evato-bone-muted);
      margin: 0;
    }
    .detail-grid {
      display: grid;
      grid-template-columns: 2fr 1fr;
      gap: 1.6rem;
      margin-bottom: 2rem;
    }
    @media (max-width: 720px) {
      .detail-grid { grid-template-columns: 1fr; }
    }
    .detail-image {
      background: rgba(26, 18, 10, 0.55);
      border: 1px solid rgba(212, 165, 94, 0.18);
      border-radius: 6px;
      overflow: hidden;
    }
    .detail-image img {
      width: 100%;
      height: auto;
      display: block;
    }
    .image-fallback {
      aspect-ratio: 16 / 10;
      display: grid;
      place-items: center;
      font-size: 5rem;
      color: rgba(212, 165, 94, 0.35);
    }
    .image-caption {
      padding: 0.5rem 0.9rem;
      font-size: 0.78rem;
      color: var(--color-evato-bone-muted);
      text-align: right;
      margin: 0;
      font-style: italic;
      border-top: 1px solid rgba(212, 165, 94, 0.12);
    }
    .image-credit {
      font-size: 0.72rem;
      color: var(--color-evato-bone-muted);
      opacity: 0.7;
    }
    .detail-secondary {
      margin-top: 0.8rem;
      border-top: 1px solid rgba(212, 165, 94, 0.18);
      padding-top: 0.8rem;
    }
    .detail-secondary img {
      width: 100%;
      height: auto;
      display: block;
      border-radius: 4px;
      filter: saturate(0.85);
    }
    .detail-stats {
      background: rgba(26, 18, 10, 0.55);
      border: 1px solid rgba(212, 165, 94, 0.18);
      border-radius: 6px;
      padding: 1.4rem;
    }
    .detail-stats dl {
      display: grid;
      grid-template-columns: 1fr;
      gap: 0.6rem 0;
      margin: 0;
    }
    .detail-stats dt {
      font-family: var(--font-display);
      font-size: 0.7rem;
      letter-spacing: 0.22em;
      text-transform: uppercase;
      color: var(--color-evato-amber);
    }
    .detail-stats dd {
      margin: 0 0 0.4rem;
      font-size: 1rem;
      color: var(--color-evato-bone);
      padding-bottom: 0.5rem;
      border-bottom: 1px dashed rgba(212, 165, 94, 0.12);
    }
    .detail-stats dd:last-child { border-bottom: 0; }
    .detail-stats a { color: var(--color-evato-amber); text-decoration: underline; text-decoration-color: rgba(212, 165, 94, 0.3); }

    .detail-blurb {
      max-width: 70ch;
      font-size: 1.15rem;
      line-height: 1.7;
      color: var(--color-evato-bone);
      padding: 1.4rem 0;
      border-top: 1px solid rgba(212, 165, 94, 0.18);
      border-bottom: 1px solid rgba(212, 165, 94, 0.18);
      margin-bottom: 1.5rem;
    }
    .field-notes {
      margin-bottom: 1.8rem;
      padding: 1.2rem;
      border: 1px solid rgba(212, 165, 94, 0.18);
      border-radius: 6px;
      background:
        radial-gradient(ellipse at 8% 0%, rgba(212, 165, 94, 0.11), transparent 42%),
        rgba(26, 18, 10, 0.48);
    }
    .section-kicker {
      margin: 0 0 0.45rem;
      color: var(--color-evato-amber);
      font-family: var(--font-display);
      font-size: 0.66rem;
      letter-spacing: 0.24em;
      text-transform: uppercase;
    }
    .field-notes h2 {
      margin: 0 0 1rem;
      color: #fff5e2;
      font-size: clamp(1.35rem, 3vw, 2rem);
      line-height: 1.08;
    }
    .field-note-grid {
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      gap: 0.75rem;
    }
    .field-note-grid article {
      min-width: 0;
      padding: 0.9rem;
      border: 1px solid rgba(212, 165, 94, 0.15);
      border-radius: 4px;
      background: rgba(13, 10, 6, 0.38);
    }
    .field-note-grid h3 {
      margin: 0;
      color: var(--color-evato-amber-bright);
      font-size: 0.9rem;
    }
    .field-note-grid p {
      margin: 0.5rem 0 0;
      color: var(--color-evato-bone-muted);
      font-size: 0.92rem;
      line-height: 1.48;
    }
    .insight-panel {
      margin-bottom: 1.8rem;
      padding: 1.2rem;
      border: 1px solid rgba(94, 143, 110, 0.24);
      border-radius: 6px;
      background:
        radial-gradient(ellipse at 92% 0%, rgba(94, 143, 110, 0.14), transparent 44%),
        rgba(13, 10, 6, 0.5);
    }
    .insight-panel h2 {
      margin: 0 0 1rem;
      color: #fff5e2;
      font-size: clamp(1.35rem, 3vw, 2rem);
      line-height: 1.08;
    }
    .insight-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 0.75rem;
    }
    .insight-grid article {
      min-width: 0;
      padding: 1rem;
      border: 1px solid rgba(94, 143, 110, 0.22);
      border-radius: 4px;
      background: rgba(13, 10, 6, 0.44);
    }
    .insight-grid span {
      color: #9bc9a6;
      font-family: var(--font-display);
      font-size: 0.62rem;
      letter-spacing: 0.18em;
      text-transform: uppercase;
    }
    .insight-grid h3 {
      margin: 0.45rem 0 0;
      color: var(--color-evato-amber-bright);
      font-size: 1rem;
      line-height: 1.2;
    }
    .insight-grid p {
