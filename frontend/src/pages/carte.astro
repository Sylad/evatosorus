---
import CodexLayout from '../layouts/CodexLayout.astro';
import PageHero from '../components/PageHero.astro';
import { PaleoMap } from '../components/PaleoMap';
// CSS Leaflet importée ici (et non dans PaleoMap.tsx) pour qu'elle ne soit
// liée qu'à cette page — cf commentaire dans PaleoMap.tsx.
import 'leaflet/dist/leaflet.css';
import 'leaflet.markercluster/dist/MarkerCluster.css';
import 'leaflet.markercluster/dist/MarkerCluster.Default.css';
import { SPECIES } from '../data/species';
import { PERIODS } from '../data/periods';

// Flatten species locations to one marker per (species, location).
const markers = SPECIES.flatMap((s) =>
  (s.locations ?? [])
    .filter((l) => typeof l.lat === 'number' && typeof l.lng === 'number')
    .map((l) => ({
      speciesId: s.id,
      name: s.name,
      commonName: s.commonName,
      lat: l.lat!,
      lng: l.lng!,
      country: l.country,
      periodId: s.periodId,
      imageUrl: s.imageUrl,
    })),
);

// Légende = ce que montrent les chiffres de la carte : des espèces distinctes
// (avant L10, « N sites » comptait les couples espèce × lieu : 31 pour 24 espèces
// au 2026-11-18).
const speciesOf = (pid: string) => new Set(markers.filter((m) => m.periodId === pid).map((m) => m.speciesId)).size;
const legend = PERIODS.map((p) => ({ id: p.id, name: p.name, color: p.accentColor, count: speciesOf(p.id) }));
const mapped = new Set(markers.map((m) => m.speciesId)).size;
const especes = (n: number) => `${n} espèce${n > 1 ? 's' : ''}`;
---
<CodexLayout
  title="Carte paléo-monde — Evatosorus"
  description="Où ont vécu les dinosaures ? Les sites fossiles des espèces phares du codex, cartographiés sur le monde actuel."
  active="carte"
>
  <PageHero videoSrc="/hero-trex-7.mp4" eyebrow="carte paléo-monde" title="Où ont vécu les dinosaures ?" />

  <header class="map-header">
    <p class="codex-lede">
      Pendant le Mésozoïque, la Pangée s'est fragmentée puis a dérivé jusqu'à
      la configuration actuelle. La carte montre où ont été trouvés, sur le
      globe d'aujourd'hui, les fossiles des {especes(mapped)} localisées du codex. Chaque pastille marque un site ; son chiffre compte les
      espèces qui y sont attestées. Couleur = période géologique.
    </p>
  </header>

  {/* Pastille de la couleur de période, dessinée comme les repères de la carte ;
      texte ivoire : en couleur de période, Trias tombait à 3,8:1 (1.4.3, L10). */}
  <ul class="map-legend" aria-label="Légende des couleurs">
    {legend.map((l) => (
      <li class="legend-item" style={`--c:${l.color}`}>
        <span class="legend-swatch" aria-hidden="true"></span>{l.name} · {especes(l.count)}
      </li>
    ))}
  </ul>

  <PaleoMap client:only="react" markers={markers} />

  <p class="map-note">
    Les coordonnées sont approximatives (capitales / régions fossiles), pas
    le site précis du gisement. Les pins regroupent plusieurs espèces sur
    le même point pour ne pas surcharger la carte ; un regroupement prend la
    couleur de sa période majoritaire. Au clavier : Tab passe d'un repère à
    l'autre, Entrée l'ouvre, Échap referme la fiche.
  </p>

  {/*
    Leaflet + leaflet.markercluster sont importés via npm dans
    PaleoMap.tsx (plus de CDN unpkg, plus de risque SRI). Vite les
    bundle et tree-shake correctement. La CSS est importée dans le
    frontmatter de cette page (liée à /carte/ seulement).
  */}

  <style>
    .map-header {
      margin-bottom: 1.5rem;
    }
    .codex-eyebrow {
      font-family: var(--font-display);
      font-size: 0.72rem;
      letter-spacing: 0.32em;
      color: var(--color-evato-amber);
      text-transform: uppercase;
      margin: 0 0 0.4rem;
    }
    .map-header h1 {
      font-size: 2.2rem;
      margin: 0 0 0.5rem;
    }
    .codex-lede {
      max-width: 65ch;
      color: var(--color-evato-bone-muted);
      font-size: 1.05rem;
      line-height: 1.6;
    }
    .map-legend {
      display: flex;
      gap: 0.8rem;
      flex-wrap: wrap;
      margin: 0 0 1rem;
      padding: 0;
      list-style: none;
    }
    .legend-item {
      font-family: var(--font-display);
      font-size: 0.6875rem; /* L52 : 12 px minimum */
      letter-spacing: 0.22em;
      text-transform: uppercase;
      padding: 0.3rem 0.7rem;
      border-radius: 999px;
      background: rgba(13, 10, 6, 0.5);
      border: 1px solid var(--c);
      color: var(--color-evato-bone);
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }
    /* Même construction que .evato-pin (PaleoMap.tsx), en réduit. */
    .legend-swatch {
      width: 0.8rem;
      height: 0.8rem;
      border-radius: 50%;
      flex-shrink: 0;
      background: radial-gradient(circle at 30% 30%, color-mix(in srgb, var(--c) 92%, white 8%), var(--c) 75%);
      border: 2px solid color-mix(in srgb, var(--c) 50%, #0d0a06);
    }
    .map-note {
      font-size: 0.85rem;
      color: var(--color-evato-bone-muted);
      font-style: italic;
      margin-top: 1rem;
      max-width: 65ch;
    }
  </style>
</CodexLayout>
